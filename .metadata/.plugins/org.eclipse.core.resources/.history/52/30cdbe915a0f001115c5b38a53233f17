spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/invoice_db
    username: postgres
    password: password
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true

  batch:
    jdbc:
      initialize-schema: always

  mail:
    host: smtp.gmail.com
    port: 587
    username: your_email@gmail.com
    password: app_password
    properties:
      mail:
        smtp:
          auth: true
          starttls:
            enable: true