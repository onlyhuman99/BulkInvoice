package com.example.demo.util;

import com.example.demo.model.Invoice;
import com.opencsv.CSVReader;
import org.springframework.web.multipart.MultipartFile;

import java.io.InputStreamReader;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;

public class CsvParserUtil {

	public static List<Invoice> parse(InputStream inputStream) throws Exception {

	    BufferedReader reader =
	            new BufferedReader(new InputStreamReader(inputStream));

	    List<Invoice> invoices = new ArrayList<>();

	    String line;
	    boolean firstLine = true;

	    while ((line = reader.readLine()) != null) {

	        if (firstLine) {
	            firstLine = false;
	            continue;
	        }

	        String[] parts = line.split(",");

	        Invoice invoice = new Invoice();
	        invoice.setInvoiceNumber(parts[0]);
	        invoice.setCustomerName(parts[1]);
	        invoice.setEmail(parts[2]);
	        invoice.setAmount(Double.parseDouble(parts[3]));
	        invoice.setStatus("PENDING");

	        invoices.add(invoice);
	    }

	    return invoices;
	}
}