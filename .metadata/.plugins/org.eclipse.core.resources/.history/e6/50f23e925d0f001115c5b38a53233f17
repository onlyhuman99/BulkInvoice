package com.example.demo.util;

import com.example.demo.model.*;
import com.opencsv.CSVReader;
iimport com.opencsv.CSVReader;
import org.springframework.web.multipart.MultipartFile;

import java.io.InputStreamReader;
import java.util.ArrayList;
import java.util.List;

public class CsvParserUtil {

    public static List<Invoice> parse(MultipartFile file) throws Exception {

        List<Invoice> invoices = new ArrayList<>();

        try (CSVReader reader =
                     new CSVReader(new InputStreamReader(file.getInputStream()))) {

            String[] line;
            reader.readNext(); // Skip header row

            while ((line = reader.readNext()) != null) {

                Invoice invoice = Invoice.builder()
                        .invoiceNumber(line[0])
                        .customerName(line[1])
                        .email(line[2])
                        .amount(Double.parseDouble(line[3]))
                        .status("CREATED")
                        .build();

                invoices.add(invoice);
            }
        }

        return invoices;
    }
}