import csv
import random
from datetime import datetime, timedelta

def generate_invoices(filename, count):
    start_date = datetime(2026, 2, 1)
    
    with open(filename, mode='w', newline='') as file:
        writer = csv.writer(file)
        writer.writerow(["InvoiceID","InvoiceDate","CustomerName",
                         "Item","Quantity","UnitPrice",
                         "TotalAmount","GST","GrandTotal"])
        
        for i in range(1, count + 1):
            quantity = random.randint(1,5)
            unit_price = random.randint(500,50000)
            total = quantity * unit_price
            gst = round(total * 0.18, 2)
            grand_total = total + gst
            
            writer.writerow([
                f"INV{i:05}",
                (start_date + timedelta(days=i%28)).date(),
                f"Customer{i}",
                "Product" + str(random.randint(1,20)),
                quantity,
                unit_price,
                total,
                gst,
                grand_total
            ])

generate_invoices("invoices_1000.csv", 1000)
generate_invoices("invoices_10000.csv", 10000)